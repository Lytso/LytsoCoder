                            <item android:offset="0.22" android:color="#16FF7A00" />
                            <item android:offset="0.42" android:color="#16FFE600" />
                            <item android:offset="0.62" android:color="#1600F5A0" />
                            <item android:offset="0.82" android:color="#1600D9FF" />
                            <item android:offset="1" android:color="#169B5CFF" />
                        </gradient>
                    </aapt:attr>
                </path>
                <path
                    android:name="bar_wide"
                    android:pathData="M54,67L75,67"
                    android:strokeWidth="13.5"
                    android:strokeLineCap="round">
                    <aapt:attr name="android:strokeColor">
                        <gradient android:type="linear" android:startX="31" android:startY="44" android:endX="77" android:endY="66">
                            <item android:offset="0" android:color="#16FF2A85" />
                            <item android:offset="0.22" android:color="#16FF7A00" />
                            <item android:offset="0.42" android:color="#16FFE600" />
                            <item android:offset="0.62" android:color="#1600F5A0" />
                            <item android:offset="0.82" android:color="#1600D9FF" />
                            <item android:offset="1" android:color="#169B5CFF" />
                        </gradient>
                    </aapt:attr>
                </path>
                <path
                    android:name="chev_soft"
                    android:pathData="M33,41L47.5,54L33,67"
                    android:strokeWidth="10.0"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round">
                    <aapt:attr name="android:strokeColor">
                        <gradient android:type="linear" android:startX="31" android:startY="44" android:endX="77" android:endY="66">
