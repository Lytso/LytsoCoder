                android:strokeColor="#B8FFFFFF"
                android:strokeWidth="1.2"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />

            <!-- Cursor '_' tube + filament (pulses gently) -->
            <path
                android:name="bar_tube"
                android:pathData="M54,67L75,67"
                android:strokeWidth="4.8"
                android:strokeLineCap="round">
                <aapt:attr name="android:strokeColor">
                    <gradient android:type="linear" android:startX="31" android:startY="44" android:endX="77" android:endY="66">
