                android:pathData="M54,67L75,67"
                android:strokeColor="#B8FFFFFF"
                android:strokeWidth="1.2"
                android:strokeLineCap="round" />
        </vector>
    </aapt:attr>

    <!-- 0-420 ms: subtle halo bloom 0.92 -> 1.04 -> 1.0 -->
    <target android:name="glow_group">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="420"
                android:interpolator="@android:interpolator/linear">
                <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0.92" />
                    <keyframe android:fraction="0.6" android:value="1.04" android:interpolator="@interpolator/splash_soft" />
                    <keyframe android:fraction="1" android:value="1" android:interpolator="@interpolator/splash_ease" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0" android:value="0.92" />
                    <keyframe android:fraction="0.6" android:value="1.04" android:interpolator="@interpolator/splash_soft" />
                    <keyframe android:fraction="1" android:value="1" android:interpolator="@interpolator/splash_ease" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <!-- Chevron halos breathe 1.0 <-> 0.55 after 450 ms -->
    <target android:name="chev_wide">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="strokeAlpha"
                android:valueFrom="1"
                android:valueTo="0.55"
                android:valueType="floatType"
                android:duration="1200"
                android:startOffset="450"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:interpolator="@interpolator/splash_ease" />
        </aapt:attr>
    </target>
    <target android:name="chev_mid">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="strokeAlpha"
                android:valueFrom="1"
                android:valueTo="0.55"
                android:valueType="floatType"
                android:duration="1200"
                android:startOffset="450"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:interpolator="@interpolator/splash_ease" />
        </aapt:attr>
    </target>
    <target android:name="chev_soft">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="strokeAlpha"
                android:valueFrom="1"
                android:valueTo="0.55"
                android:valueType="floatType"
                android:duration="1200"
                android:startOffset="450"
